<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lp100a.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <!-- Original pre-W2 palette experiment: near-black bg, near-white text, orange-red + cyan accents.
         (W2 palette was Bg #1C1C1E, Panel #2C2C30, Track #3C3C42, Text #DCDCDC, Amber #FFB000,
         Red #EB4646, Dim #8C8C94, Cyan #00D2EB — restore these to go back.) Kept in sync with Palette.cs. -->
    <SolidColorBrush x:Key="BgBrush"    Color="#171717"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#333333"/>
    <SolidColorBrush x:Key="TextBrush"  Color="#EAEAEA"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#FF5A2A"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#3CC850"/>
    <SolidColorBrush x:Key="RedBrush"   Color="#E64C4C"/>
    <SolidColorBrush x:Key="DimBrush"   Color="#999999"/>
    <SolidColorBrush x:Key="CyanBrush"  Color="#2AC8C8"/>
    <!-- FORWARD POWER hero -->
    <SolidColorBrush x:Key="HeroBrush"  Color="#3CC850"/>
    <!-- App-name title (independent of the green hero) -->
    <SolidColorBrush x:Key="TitleBrush" Color="#4A90E2"/>
    <!-- Forward power bar -->
    <SolidColorBrush x:Key="BlueBrush"  Color="#4A90E2"/>
    <!-- SWR bar (static; the SWR number stays threshold-colored) -->
    <SolidColorBrush x:Key="GoldBrush"  Color="#FFB000"/>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- DataGrid brings its own theme; without this the TX log viewer renders as a blank area. -->
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

    <!-- Tabs.
         Fluent draws tab headers as plain text with a thin selection "pipe" underneath, which on
         this dark palette reads as a row of labels rather than tabs. Both templates are replaced
         to get real tab chrome: outlined, rounded on top, the selected one filled with the content
         panel's colour and pulled down 1px so it merges into the panel below it. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
      <Setter Property="Background" Value="{StaticResource BgBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="TabItem">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource TrackBrush}"
                  BorderThickness="1,1,1,0"
                  CornerRadius="6,6,0,0"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              FontSize="{TemplateBinding FontSize}"
                              FontWeight="{TemplateBinding FontWeight}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource BlueBrush}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <!-- Overlap the panel border by 1px so the active tab and the panel read as one shape. -->
      <Setter Property="Margin" Value="0,0,3,-1"/>
    </Style>

    <Style Selector="TabItem:pointerover">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style Selector="TabControl">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <ItemsPresenter DockPanel.Dock="Top"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            Margin="2,0,0,0"/>
            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource TrackBrush}"
                    BorderThickness="1"
                    CornerRadius="0,6,6,6"
                    ZIndex="-1">
              <ContentPresenter Content="{TemplateBinding SelectedContent}"
                                ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
            </Border>
          </DockPanel>
        </ControlTemplate>
      </Setter>
    </Style>
  </Application.Styles>

</Application>
