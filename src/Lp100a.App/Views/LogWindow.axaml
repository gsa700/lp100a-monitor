<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lp100a.App.ViewModels"
        xmlns:core="using:Lp100a.Core"
        x:Class="Lp100a.App.Views.LogWindow"
        x:DataType="vm:LogViewModel"
        Width="1080" Height="520" MinWidth="520" MinHeight="280"
        Background="{StaticResource BgBrush}"
        Icon="/Assets/app-icon.png"
        Title="LP-100A Transmission Log">

  <DockPanel Margin="12">

    <!-- Action bar -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,10,0,0">
      <Grid.Styles>
        <!-- These buttons carry a MinWidth, so their content presenter is wider than the label;
             without this the text sits left inside the button instead of centred. -->
        <Style Selector="Button">
          <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
      </Grid.Styles>

      <Button Grid.Column="0" Content="Refresh" Command="{Binding RefreshCommand}" MinWidth="90"/>
      <!-- Not "Open in Excel": plenty of stations have no Excel. This hands the .csv to whatever
           the OS has registered — LibreOffice, Numbers, a text editor. -->
      <Button Grid.Column="1" Content="Open CSV" Command="{Binding OpenCsvCommand}"
              Margin="8,0,0,0" MinWidth="120"
              ToolTip.Tip="Open the log file in your default spreadsheet or text app."/>
      <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                 VerticalAlignment="Center" Margin="14,0" TextWrapping="NoWrap"/>
      <!-- Sits across the status text from Refresh so it isn't a neighbour of the button you click
           most. It archives rather than deletes, so a mis-click costs nothing but a rename. -->
      <Button Grid.Column="3" Content="Clear log" Command="{Binding ClearCommand}"
              Margin="0,0,8,0" MinWidth="90"
              ToolTip.Tip="Start a fresh log. The current one is renamed aside with a timestamp, not deleted."/>
      <Button Grid.Column="4" Content="Close" Click="OnCloseClick" MinWidth="80"/>
    </Grid>

    <!-- x:DataType goes on each column Binding, not on the DataGrid: setting it here would also
         retarget ItemsSource (which must resolve against the view model, not the row type). -->
    <DataGrid x:Name="Grid"
              ItemsSource="{Binding Rows}"
              IsReadOnly="True"
              CanUserSortColumns="True"
              CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal"
              HeadersVisibility="Column"
              FontFamily="Consolas"
              FontSize="12"
              Background="{StaticResource PanelBrush}"
              Foreground="{StaticResource TextBrush}">

      <DataGrid.Styles>
        <!-- Numeric columns read far better right-aligned; the text ones stay left. -->
        <Style Selector="DataGridCell.num TextBlock">
          <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
      </DataGrid.Styles>

      <DataGrid.Columns>
        <!-- Widths are sized to the HEADER text, not just the values: at Consolas 12 the earlier
             narrower columns clipped their own captions ("Freq MH", "SWR@pl", "Ran"). Fixed rather
             than Auto so columns don't re-jitter as virtualized rows scroll into view. -->
        <DataGridTextColumn Header="Time" Width="180"
                            Binding="{Binding Start, x:DataType=core:TxLogEntry, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
        <DataGridTextColumn Header="Freq MHz" Width="100" CellStyleClasses="num"
                            Binding="{Binding FreqMhz, x:DataType=core:TxLogEntry, StringFormat={}{0:F4}}"/>
        <DataGridTextColumn Header="Dur s" Width="72" CellStyleClasses="num"
                            Binding="{Binding DurationSeconds, x:DataType=core:TxLogEntry}"/>
        <DataGridTextColumn Header="Peak W" Width="92" CellStyleClasses="num"
                            Binding="{Binding PeakForwardW, x:DataType=core:TxLogEntry, StringFormat={}{0:F1}}"/>
        <DataGridTextColumn Header="Max SWR" Width="98" CellStyleClasses="num"
                            Binding="{Binding MaxSwr, x:DataType=core:TxLogEntry, StringFormat={}{0:F2}}"/>
        <DataGridTextColumn Header="SWR @ pk" Width="105" CellStyleClasses="num"
                            Binding="{Binding SwrAtPeak, x:DataType=core:TxLogEntry, StringFormat={}{0:F2}}"/>
        <DataGridTextColumn Header="RL dB" Width="80" CellStyleClasses="num"
                            Binding="{Binding MinReturnLossDb, x:DataType=core:TxLogEntry, StringFormat={}{0:F1}}"/>
        <DataGridTextColumn Header="R + jX Ω" Width="140"
                            Binding="{Binding RxText, x:DataType=core:TxLogEntry}"/>
        <DataGridTextColumn Header="Range" Width="80"
                            Binding="{Binding RangeText, x:DataType=core:TxLogEntry}"/>
        <DataGridTextColumn Header="Timed out" Width="105"
                            Binding="{Binding TimedOutText, x:DataType=core:TxLogEntry}"/>
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</Window>
