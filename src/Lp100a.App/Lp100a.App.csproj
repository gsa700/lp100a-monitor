<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>Lp100aMonitor</AssemblyName>
    <Version>0.9.20-beta</Version>
    <Product>LP-100A Monitor</Product>
    <Authors>David Erickson (AB0R)</Authors>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!-- Release is a TRUE single file: the in-app updater replaces only the exe, so the native
         libs (Skia/HarfBuzz/ANGLE) MUST be bundled into it, not shipped loose. Without
         IncludeNativeLibrariesForSelfExtract the updated exe lands with no native deps and
         crashes on launch. Applies on publish with a RID; ignored by build/run. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <!-- Also embedded plainly: the Linux installer writes this icon to the XDG icon directory for
         the .desktop entry, and the install switch runs before Avalonia is initialised, so the
         Avalonia asset loader isn't available to read it. ~29 KB. -->
    <EmbeddedResource Include="Assets/app-icon.png" LogicalName="app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia 12.x. Bump with: dotnet add package Avalonia -->
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <!-- DataGrid ships separately from core Avalonia; used by the TX log viewer. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <!-- No Avalonia.Diagnostics: it has no 12.x release, and nothing here ever called
         AttachDevTools(), so the old Debug-only reference was dead weight. -->

  </ItemGroup>

  <ItemGroup>
    <!-- WMI for USB-serial chip-serial pinning (Windows-only; guarded at runtime) -->
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lp100a.Core\Lp100a.Core.csproj" />
  </ItemGroup>

  <!-- Avalonia 12 pulls SkiaSharp/HarfBuzzSharp builds that ship native .pdb symbols
       (libSkiaSharp ~81 MB, libHarfBuzzSharp ~20 MB). Unlike the natives themselves these are
       NOT bundled into the single file — they land loose next to the exe and would roughly
       triple every release zip. Nobody running a release needs them. The managed pdbs are tiny
       and stay, so crash traces from the app's own code still resolve. -->
  <Target Name="TrimNativeSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.pdb' And $([System.String]::Copy('%(Filename)').StartsWith('lib'))" />
    </ItemGroup>
  </Target>

</Project>
